rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function hasRole(role) { return signedIn() && profile().role == role; }
    function isOperationalStaff() {
      return hasRole('platform_super_admin') || hasRole('org_admin') || hasRole('office_manager')
        || hasRole('team_leader') || hasRole('counsellor') || hasRole('admissions_officer')
        || hasRole('compliance_officer') || hasRole('visa_officer');
    }
    function isStudentOwner(studentId) {
      return hasRole('student')
        && firestore.get(/databases/(default)/documents/students/$(studentId)).data.email == request.auth.token.email;
    }
    function validUpload() {
      return request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*|application/msword|application/vnd.openxmlformats-officedocument.*');
    }

    // Document IDs are generated by the client, while this fixed path prevents arbitrary
    // files from being placed elsewhere in the bucket.
    match /student_documents/{studentId}/{documentId} {
      allow read: if isOperationalStaff() || isStudentOwner(studentId);
      allow create: if (isOperationalStaff() || isStudentOwner(studentId)) && validUpload();
      allow update: if isOperationalStaff() && validUpload();
      allow delete: if hasRole('platform_super_admin') || hasRole('org_admin');
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
