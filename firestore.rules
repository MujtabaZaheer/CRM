>>>>>>> a1ca141 (Implement Visa Officer Student and Support modules)
    }

    function isManagement() {
      return isSuperAdmin() || isOrgAdmin() || isTeamLeader();
    }

    // ----------------------------------------------------
    // USERS COLLECTION
    // ----------------------------------------------------
    match /users/{userId} {
      // Anyone signed in can read user profiles (needed for directory & auth context)
      allow read: if isSignedIn();
      
      // Self-registration: User can create their initial profile document
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // Role & profile updates: Super Admin or Org Admin can update any profile. Users can update non-role fields of their own document.
      allow update: if isSuperAdmin() || isOrgAdmin() || 
        (isSignedIn() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
        
      allow delete: if isSuperAdmin();
    }

    // ----------------------------------------------------
    // LEADS COLLECTION
    // ----------------------------------------------------
    match /leads/{leadId} {
      // Super Admin, Org Admin, and Counsellors can read and create leads
      allow read: if isManagement() || isCounsellor() || isAdmissionsOfficer();
      allow create: if isManagement() || isCounsellor();
      
      // Updates and deletions
      allow update: if isManagement() || isCounsellor();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

