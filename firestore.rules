    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isManagement() || isCounsellor() || isFinanceOfficer() || isAdmissionsOfficer() || isSupportUser() || isAuditor();
    }

    match /support_tickets/{ticketId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    match /support_articles/{articleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() || isOrgAdmin() || isSupportUser();
    }

    // Finance collections are intentionally isolated from operational roles.
    // Finance Officers, administrators, and Auditors can inspect these records.
    match /invoices/{invoiceId} {
      allow read: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer() || isAuditor();
      allow create, update: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer() || isAuditor();
      allow create, update: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    match /refunds/{refundId} {
      allow read: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer() || isAuditor();
      allow create, update: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    match /commissions/{commissionId} {
      allow read: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer() || isAuditor();
      allow create, update: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

  }
}
