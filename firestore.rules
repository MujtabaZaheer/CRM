rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for auth & role verification
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'platform_super_admin';
    }
    
    function isOrgAdmin() {
      return isSignedIn() && getUserData().role == 'org_admin';
    }
    
    function isCounsellor() {
      return isSignedIn() && getUserData().role == 'counsellor';
    }

    function isTeamLeader() {
      return isSignedIn() && getUserData().role == 'team_leader';
    }

    function isFinanceOfficer() {
      return isSignedIn() && getUserData().role == 'finance_officer';
    }

    function isAdmissionsOfficer() {
      return isSignedIn() && getUserData().role == 'admissions_officer';
    }

    function isVisaOfficer() {
      return isSignedIn() && getUserData().role == 'visa_officer';
    }

    function isSupportUser() {
      return isSignedIn() && getUserData().role == 'support_user';
    }

    function isAuditor() {
      return isSignedIn() && (getUserData().role == 'auditor' || getUserData().role == 'compliance_officer');
    }

    function isStudent() {
      return isSignedIn() && getUserData().role == 'student';
    }

    function ownsStudent(studentId) {
      return isStudent() && get(/databases/$(database)/documents/students/$(studentId)).data.email == request.auth.token.email;
    }

    function isManagement() {
      return isSuperAdmin() || isOrgAdmin() || isTeamLeader();
    }

    // ----------------------------------------------------
    // USERS COLLECTION
    // ----------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSuperAdmin() || isOrgAdmin() || 
        (isSignedIn() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isSuperAdmin();
    }

    // ----------------------------------------------------
    // LEADS COLLECTION
    // ----------------------------------------------------
    match /leads/{leadId} {
      allow read: if isManagement() || isCounsellor() || isAdmissionsOfficer() || isAuditor();
      allow create: if isManagement() || isCounsellor();
      allow update: if isManagement() || isCounsellor();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    // ----------------------------------------------------
    // APPLICATIONS COLLECTION
    // ----------------------------------------------------
    match /applications/{applicationId} {
      allow read: if isManagement() || isCounsellor() || isAdmissionsOfficer() || isVisaOfficer() || isSupportUser() || isAuditor() || ownsStudent(resource.data.studentId);
      allow create: if isSuperAdmin() || isOrgAdmin() || isCounsellor() || isAdmissionsOfficer();
      allow update: if isSuperAdmin() || isOrgAdmin() || isCounsellor() || isAdmissionsOfficer() || isVisaOfficer() ||
        (isTeamLeader() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedCounsellor', 'updatedAt']));
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    // ----------------------------------------------------
    // STUDENTS COLLECTION
    // ----------------------------------------------------
    match /students/{studentId} {
      allow read: if isManagement() || isCounsellor() || isAdmissionsOfficer() || isVisaOfficer() || isSupportUser() || isAuditor() || ownsStudent(studentId);
      allow create, update: if isSuperAdmin() || isOrgAdmin() || isCounsellor() || isAdmissionsOfficer() || isVisaOfficer() ||
        (ownsStudent(studentId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'countryOfResidence', 'notes', 'updatedAt']));
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    // ----------------------------------------------------
    // STUDENT DOCUMENTS COLLECTION
    // ----------------------------------------------------
    match /student_documents/{docId} {
      allow read: if isManagement() || isCounsellor() || isAdmissionsOfficer() || isVisaOfficer() || isSupportUser() || isAuditor() || ownsStudent(resource.data.studentId);
      allow create, update: if isManagement() || isCounsellor() || isAdmissionsOfficer() || isVisaOfficer() ||
        (isStudent() && request.resource.data.studentId != null && ownsStudent(request.resource.data.studentId));
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    // ----------------------------------------------------
    // TASKS COLLECTION
    // ----------------------------------------------------
    match /tasks/{taskId} {
      allow read, create, update: if isManagement() || isCounsellor() || isAdmissionsOfficer() || isVisaOfficer() || isSupportUser() ||
        (isStudent() && resource.data.assignedTo == request.auth.token.email);
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    // ----------------------------------------------------
    // VISA CASES COLLECTION
    // ----------------------------------------------------
    match /visa_cases/{caseId} {
      allow read: if isSuperAdmin() || isOrgAdmin() || isVisaOfficer() || isAuditor() ||
        (isStudent() && ownsStudent(resource.data.studentId));
      allow create, update: if isSuperAdmin() || isOrgAdmin() || isVisaOfficer();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    // ----------------------------------------------------
    // SUPPORT REQUESTS COLLECTION
    // ----------------------------------------------------
    match /support_requests/{requestId} {
      allow read: if isSuperAdmin() || isOrgAdmin() || isSupportUser() || isAuditor() ||
        (isStudent() && resource.data.studentId != null && ownsStudent(resource.data.studentId));
      allow create: if isSuperAdmin() || isOrgAdmin() || isSupportUser() ||
        (isStudent() && request.resource.data.studentId != null && ownsStudent(request.resource.data.studentId));
      allow update: if isSuperAdmin() || isOrgAdmin() || isSupportUser();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    // ----------------------------------------------------
    // AUDIT LOGS COLLECTION
    // ----------------------------------------------------
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    // ----------------------------------------------------
    // SUPPORT TICKETS & ARTICLES
    // ----------------------------------------------------
    match /support_tickets/{ticketId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    match /support_articles/{articleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() || isOrgAdmin() || isSupportUser();
    }

    // ----------------------------------------------------
    // FINANCE COLLECTIONS
    // ----------------------------------------------------
    match /invoices/{invoiceId} {
      allow read: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer() || isAuditor();
      allow create, update: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer() || isAuditor();
      allow create, update: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    match /refunds/{refundId} {
      allow read: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer() || isAuditor();
      allow create, update: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    match /commissions/{commissionId} {
      allow read: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer() || isAuditor();
      allow create, update: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

  }
}
