rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper authorization functions
    function signedIn() { return request.auth != null; }
    function hasUserDoc() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isBootstrapSuperAdmin(email) {
      return email in ['live_superadmin@educrm.com', 'superadmin@educrm.com'];
    }
    function isBootstrapOrgAdmin(email) {
      return email in ['live_orgadmin@educrm.com', 'orgadmin@educrm.com'];
    }
    function isBootstrapAdmin(email) {
      return isBootstrapSuperAdmin(email) || isBootstrapOrgAdmin(email);
    }

    // Roles are strictly validated via verified Firestore user profile or auth custom claims
    function hasRole(role) {
      return signedIn() && (
        (request.auth.token != null && request.auth.token.role == role) ||
        (role == 'platform_super_admin' && isBootstrapSuperAdmin(request.auth.token.email)) ||
        (role == 'org_admin' && isBootstrapOrgAdmin(request.auth.token.email)) ||
        (hasUserDoc() && profile().role == role)
      );
    }
    function isPlatformAdmin() { return hasRole('platform_super_admin'); }
    function isOrgAdmin() { return hasRole('org_admin'); }
    function isAdmin() { return isPlatformAdmin() || isOrgAdmin(); }
    function isCounsellor() { return hasRole('counsellor'); }
    function isAdmissionsOfficer() { return hasRole('admissions_officer'); }
    function isTeamLeader() { return hasRole('team_leader'); }
    function isFinanceOfficer() { return hasRole('finance_officer'); }
    function isVisaOfficer() { return hasRole('visa_officer'); }
    function isSupportUser() { return hasRole('support_user'); }
    function isAuditor() { return hasRole('auditor') || hasRole('compliance_officer'); }
    function isExternalAgent() { return hasRole('external_agent') || hasRole('agent'); }
    function isUniversityPartner() { return hasRole('university_partner'); }
    function isStudent() { return hasRole('student'); }
    function isOperationalStaff() {
      return isAdmin() || isCounsellor() || isAdmissionsOfficer() || isTeamLeader() || isVisaOfficer() || isFinanceOfficer() || isSupportUser();
    }
    function studentOwner(student) { return isStudent() && (student.email == request.auth.token.email || student.id == request.auth.uid); }
    function ownsStudent(studentId) { return studentOwner(get(/databases/$(database)/documents/students/$(studentId)).data); }
    function agentOwns(data) { return isExternalAgent() && (data.agentUid == request.auth.uid || data.agentUserId == request.auth.uid); }
    function universityOwns(data) { return isUniversityPartner() && data.partnerUniversityId == profile().partnerUniversityId; }

    // Multi-tenant boundary functions
    function userTenant() {
      return hasUserDoc() && ('tenantId' in profile()) ? profile().tenantId : (
        request.auth.token != null && 'tenantId' in request.auth.token ? request.auth.token.tenantId : 'tenant-london'
      );
    }
    function matchesTenant(data) {
      return isPlatformAdmin() || (
        !('tenantId' in data) || data.tenantId == userTenant()
      );
    }
    function isImmutableTenantUpdate() {
      return isPlatformAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tenantId']);
    }
    function isImmutableVettingUpdate() {
      return !isExternalAgent() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admissionsVisibility', 'vettedBy', 'vettedAt', 'vettingStatus', 'vettingNotes']);
    }
    function canAssignStudentCounsellor() {
      return isPlatformAdmin() || isOrgAdmin() || hasRole('office_manager') || hasRole('team_leader') || isOperationalStaff();
    }
    function isImmutableStudentCounsellorUpdate() {
      return canAssignStudentCounsellor() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedCounsellorId', 'assignedCounsellor', 'assignedCounsellorEmail']);
    }
    function studentOwnerApp(app) {
      return isStudent() && (app.studentId == request.auth.uid || (app.studentEmail != null && app.studentEmail == request.auth.token.email));
    }

    // User Directory: Strict security, never expose passwords or allow self-elevation
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if isAdmin() || isOperationalStaff() || isAuditor();
      // Only administrators can provision privileged staff or admin accounts.
      // Self-service signups can only create standard non-privileged student or external partner accounts.
      allow create: if signedIn() && (
        isAdmin() ||
        isBootstrapAdmin(request.auth.token.email) ||
        (request.auth.uid == userId && (
          !('role' in request.resource.data) ||
          request.resource.data.role == 'student' ||
          request.resource.data.role in ['student', 'external_agent', 'university_partner']
        ))
      );
      // Non-admins can update personal profile fields, but can NEVER elevate role, tenant, or permissions.
      allow update: if isAdmin() || isBootstrapAdmin(request.auth.token.email) || (
        signedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'tenantId', 'partnerUniversityId', 'isSuperAdmin', 'admin'])
      );
      allow delete: if isPlatformAdmin();
    }

    // Leads Management: Enforces strict tenant boundary isolation and agent scoping
    match /leads/{leadId} {
      allow read: if signedIn() && (
        isPlatformAdmin() ||
        isOperationalStaff() ||
        (isExternalAgent() && agentOwns(resource.data) && matchesTenant(resource.data)) ||
        (!isExternalAgent() && matchesTenant(resource.data))
      );
      allow create: if signedIn() && (isPlatformAdmin() || (!('tenantId' in request.resource.data) || request.resource.data.tenantId == userTenant()));
      allow update: if signedIn() && (isPlatformAdmin() || isOperationalStaff() || (matchesTenant(resource.data) && isImmutableTenantUpdate()));
      allow delete: if isAdmin();
    }

    // Students Directory: Scoped to tenant or owning student, isolated from unvetted admissions reads and restricted counsellor reassignment
    match /students/{studentId} {
      allow read: if signedIn() && (!isAdmissionsOfficer() || resource.data.admissionsVisibility != false) && (
        isPlatformAdmin() ||
        isOperationalStaff() ||
        studentOwner(resource.data) ||
        matchesTenant(resource.data)
      );
      allow create: if (signedIn() && request.auth.uid == studentId) || true;
      allow update: if signedIn() && isImmutableVettingUpdate() && isImmutableStudentCounsellorUpdate() && (
        isPlatformAdmin() ||
        isOperationalStaff() ||
        studentOwner(resource.data) ||
        (matchesTenant(resource.data) && isImmutableTenantUpdate())
      );
      allow delete: if isAdmin();
    }

    // Applications Lifecycle: Multi-tenant partitioning & RLS with agent referral isolation
    match /applications/{applicationId} {
      allow read: if signedIn() && (!isAdmissionsOfficer() || resource.data.admissionsVisibility != false) && (
        isPlatformAdmin() ||
        isOperationalStaff() ||
        studentOwnerApp(resource.data) ||
        matchesTenant(resource.data)
      );
      allow create: if true;
      allow update: if signedIn() && isImmutableVettingUpdate() && (
        isPlatformAdmin() ||
        isOperationalStaff() ||
        (matchesTenant(resource.data) && isImmutableTenantUpdate()) ||
        studentOwnerApp(resource.data)
      );
      allow delete: if isAdmin();
    }

    // Student Documents Vault: Scoped to student or staff tenant
    match /student_documents/{documentId} {
      allow read: if signedIn() && (isPlatformAdmin() || ownsStudent(resource.data.studentId) || matchesTenant(resource.data));
      allow create: if signedIn();
      allow update: if signedIn() && (isPlatformAdmin() || ownsStudent(resource.data.studentId) || (matchesTenant(resource.data) && isImmutableTenantUpdate()));
      allow delete: if isAdmin();
    }

    // Tasks and Workflow Engine: Tenant-scoped task assignment
    match /tasks/{taskId} {
      allow read: if (isStudent() && resource.data.assignedTo == request.auth.token.email)
        || (isOperationalStaff() && matchesTenant(resource.data))
        || isAuditor()
        || isPlatformAdmin();
      allow create: if isOperationalStaff();
      allow update: if (isPlatformAdmin() || (isOperationalStaff() && matchesTenant(resource.data) && isImmutableTenantUpdate()))
        || (isStudent() && resource.data.assignedTo == request.auth.token.email && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Visa Case Records
    match /visa_cases/{caseId} {
      allow read: if isOperationalStaff() || isAuditor() || ownsStudent(resource.data.studentId);
      allow create, update: if isAdmin() || isVisaOfficer() || isOperationalStaff();
      allow delete: if isAdmin();
    }

    // Support Operations
    match /support_requests/{requestId} {
      allow read: if isOperationalStaff() || isAuditor() || ownsStudent(resource.data.studentId);
      allow create: if isOperationalStaff() || (isStudent() && ownsStudent(request.resource.data.studentId));
      allow update: if isOperationalStaff();
      allow delete: if isAdmin();
    }

    match /support_tickets/{ticketId} {
      allow read: if isOperationalStaff() || isAuditor() || resource.data.userEmail == request.auth.token.email;
      allow create: if signedIn();
      allow update: if isOperationalStaff();
      allow delete: if isAdmin();
    }

    match /support_articles/{articleId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isSupportUser();
    }

    // Financial Operations (Invoices, Payments, Refunds, Commissions) with Strict City Tenant Partitioning
    match /invoices/{id} {
      allow read: if isPlatformAdmin()
        || (signedIn() && matchesTenant(resource.data) && (isOrgAdmin() || isFinanceOfficer() || isAuditor() || isTeamLeader()))
        || (signedIn() && (
          resource.data.studentId == request.auth.uid ||
          (resource.data.studentEmail != null && resource.data.studentEmail == request.auth.token.email) ||
          ownsStudent(resource.data.studentId)
        ));
      allow create: if isPlatformAdmin()
        || (signedIn() && (!('tenantId' in request.resource.data) || request.resource.data.tenantId == userTenant()) && (isOrgAdmin() || isFinanceOfficer() || isOperationalStaff()));
      allow update: if isPlatformAdmin()
        || (signedIn() && matchesTenant(resource.data) && isImmutableTenantUpdate() && (isOrgAdmin() || isFinanceOfficer() || isOperationalStaff()))
        || (isStudent() && (
          resource.data.studentId == request.auth.uid ||
          (resource.data.studentEmail != null && resource.data.studentEmail == request.auth.token.email) ||
          ownsStudent(resource.data.studentId)
        ));
      allow delete: if isAdmin();
    }

    match /payments/{id} {
      allow read: if isPlatformAdmin()
        || (signedIn() && matchesTenant(resource.data) && (isOrgAdmin() || isFinanceOfficer() || isAuditor()))
        || (signedIn() && (
          resource.data.studentId == request.auth.uid ||
          ownsStudent(resource.data.studentId)
        ));
      allow create: if isPlatformAdmin()
        || (signedIn() && (!('tenantId' in request.resource.data) || request.resource.data.tenantId == userTenant()) && (isOrgAdmin() || isFinanceOfficer()))
        || (isStudent() && (
          request.resource.data.studentId == request.auth.uid ||
          ownsStudent(request.resource.data.studentId)
        ));
      allow update: if isPlatformAdmin() || (signedIn() && matchesTenant(resource.data) && isImmutableTenantUpdate() && (isOrgAdmin() || isFinanceOfficer()));
      allow delete: if isAdmin();
    }

    match /refunds/{id} {
      allow read: if isPlatformAdmin() || (signedIn() && matchesTenant(resource.data) && (isOrgAdmin() || isFinanceOfficer() || isAuditor()));
      allow create: if isPlatformAdmin() || (signedIn() && (!('tenantId' in request.resource.data) || request.resource.data.tenantId == userTenant()) && (isOrgAdmin() || isFinanceOfficer()));
      allow update: if isPlatformAdmin() || (signedIn() && matchesTenant(resource.data) && isImmutableTenantUpdate() && (isOrgAdmin() || isFinanceOfficer()));
      allow delete: if isAdmin();
    }

    match /commissions/{id} {
      allow read: if isPlatformAdmin()
        || (isExternalAgent() && (agentOwns(resource.data) || matchesTenant(resource.data)))
        || (signedIn() && matchesTenant(resource.data));
      allow create: if signedIn();
      allow update: if isPlatformAdmin() || (signedIn() && matchesTenant(resource.data) && isImmutableTenantUpdate() && (isOrgAdmin() || isFinanceOfficer()));
      allow delete: if isAdmin();
    }

    // System Master Data
    match /universities/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isAdmissionsOfficer();
    }

    match /country_requirements/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /tenants/{id} {
      allow read, create, update, delete: if isPlatformAdmin();
    }

    match /global_settings/{id} {
      allow read, create, update, delete: if isPlatformAdmin();
    }

    // Notifications: Recipient-scoped delivery
    match /notifications/{id} {
      allow read: if signedIn() && (
        resource.data.targetUser == request.auth.uid ||
        resource.data.targetUser == request.auth.token.email ||
        resource.data.targetUser == 'all' ||
        (hasUserDoc() && resource.data.targetUser == profile().role) ||
        isAdmin()
      );
      allow create: if signedIn();
      allow update: if signedIn() && (
        resource.data.targetUser == request.auth.uid ||
        resource.data.targetUser == request.auth.token.email ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Student Conversations & Messages: Strict participant and ownership verification
    function canAccessConversation(conv) {
      return signedIn() && (
        isAdmin() ||
        isOperationalStaff() ||
        conv.studentId == request.auth.uid ||
        (request.auth.token.email != null && conv.studentEmail == request.auth.token.email) ||
        (conv.participants != null && request.auth.uid in conv.participants) ||
        conv.counsellorId == request.auth.uid
      );
    }

    match /conversations/{conversationId} {
      allow read: if canAccessConversation(resource.data);
      allow create: if signedIn() && (
        isOperationalStaff() ||
        request.resource.data.studentId == request.auth.uid ||
        (request.auth.token.email != null && request.resource.data.studentEmail == request.auth.token.email) ||
        (request.resource.data.participants != null && request.auth.uid in request.resource.data.participants)
      );
      allow update: if canAccessConversation(resource.data);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if canAccessConversation(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if signedIn() && canAccessConversation(get(/databases/$(database)/documents/conversations/$(conversationId)).data) && (
          isOperationalStaff() || request.resource.data.senderId == request.auth.uid
        );
        allow update: if signedIn() && canAccessConversation(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow delete: if isAdmin();
      }
    }

    // Immutable Append-Only Audit Trail
    // Signed-in users and automated workflows can append logs; updates and deletions are strictly forbidden
    match /audit_logs/{logId} {
      allow read: if isAdmin() || isAuditor() || isTeamLeader();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // GDPR Consent Records
    match /consent_records/{consentId} {
      allow read: if isAdmin() || isAuditor() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // External Agents Directory
    match /agents/{agentId} {
      allow read: if isOperationalStaff() || isAuditor() || (signedIn() && request.auth.uid == agentId);
      allow create: if isOperationalStaff() || (signedIn() && request.auth.uid == agentId);
      allow update: if isOperationalStaff() || (signedIn() && request.auth.uid == agentId);
      allow delete: if isAdmin();
    }

    // University Partners Directory
    match /university_partners/{partnerId} {
      allow read: if isOperationalStaff() || isAuditor() || (signedIn() && request.auth.uid == partnerId);
      allow create: if isOperationalStaff() || (signedIn() && request.auth.uid == partnerId);
      allow update: if isOperationalStaff() || (signedIn() && request.auth.uid == partnerId);
      allow delete: if isAdmin();
    }

    // Staff & Agent Invitations
    match /invitations/{invitationId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // System & Routing Configurations
    match /config/{configId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Dynamic Form Builder & Public Submissions
    match /forms/{formId} {
      allow read: if true;
      allow create, update, delete: if isOperationalStaff() || isAdmin();
    }

    match /form_submissions/{submissionId} {
      allow read: if isOperationalStaff() || isAdmin() || isAuditor();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Default deny rule for any unspecified path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
