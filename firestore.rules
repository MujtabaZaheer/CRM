rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ╔══════════════════════════════════════════════════════════════════╗
    // ║  DEMO MODE — ALL COLLECTIONS OPEN FOR READ/WRITE              ║
    // ║  Revert to role-based rules before production deployment.     ║
    // ║  Original rules are preserved in git history.                 ║
    // ╚══════════════════════════════════════════════════════════════════╝

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
