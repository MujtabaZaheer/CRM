rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for auth & role verification
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'platform_super_admin';
    }
    
    function isOrgAdmin() {
      return isSignedIn() && getUserData().role == 'org_admin';
    }
    
    function isCounsellor() {
      return isSignedIn() && getUserData().role == 'counsellor';
    }

    function isTeamLeader() {
      return isSignedIn() && getUserData().role == 'team_leader';
    }

    function isFinanceOfficer() {
      return isSignedIn() && getUserData().role == 'finance_officer';
    }

    function isAdmissionsOfficer() {
      return isSignedIn() && getUserData().role == 'admissions_officer';
    }

    function isSupportUser() {
      return isSignedIn() && getUserData().role == 'support_user';
    }

    function isAuditor() {
      return isSignedIn() && (getUserData().role == 'auditor' || getUserData().role == 'compliance_officer');
    }

    function isManagement() {
      return isSuperAdmin() || isOrgAdmin() || isTeamLeader();
    }

    // ----------------------------------------------------
    // USERS COLLECTION
    // ----------------------------------------------------
    match /users/{userId} {
      // Anyone signed in can read user profiles (needed for directory & auth context)
      allow read: if isSignedIn();
      
      // Self-registration: User can create their initial profile document
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // Role & profile updates: Super Admin or Org Admin can update any profile. Users can update non-role fields of their own document.
      allow update: if isSuperAdmin() || isOrgAdmin() || 
        (isSignedIn() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
        
      allow delete: if isSuperAdmin();
    }

    // ----------------------------------------------------
    // LEADS COLLECTION
    // ----------------------------------------------------
    match /leads/{leadId} {
      // Super Admin, Org Admin, and Counsellors can read and create leads
      allow read: if isManagement() || isCounsellor() || isAdmissionsOfficer();
      allow create: if isManagement() || isCounsellor();
      
      // Updates and deletions
      allow update: if isManagement() || isCounsellor();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    match /applications/{applicationId} {
      allow read: if isManagement() || isCounsellor() || isAdmissionsOfficer();
      allow create: if isSuperAdmin() || isOrgAdmin() || isCounsellor() || isAdmissionsOfficer();
      allow update: if isSuperAdmin() || isOrgAdmin() || isCounsellor() || isAdmissionsOfficer() ||
        (isTeamLeader() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['assignedCounsellor', 'updatedAt']));
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    match /students/{studentId} {
      allow read: if isManagement() || isCounsellor() || isAdmissionsOfficer();
      allow create, update: if isSuperAdmin() || isOrgAdmin() || isCounsellor() || isAdmissionsOfficer();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    match /student_documents/{docId} {
      allow read: if isManagement() || isCounsellor() || isAdmissionsOfficer();
      allow create, update: if isManagement() || isCounsellor() || isAdmissionsOfficer();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    match /tasks/{taskId} {
      allow read, create, update: if isManagement() || isCounsellor() || isAdmissionsOfficer();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isManagement() || isCounsellor() || isFinanceOfficer() || isAdmissionsOfficer() || isSupportUser() || isAuditor();
    }

    match /support_tickets/{ticketId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    match /support_articles/{articleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() || isOrgAdmin() || isSupportUser();
    }

    // Finance collections are intentionally isolated from operational roles.
    // Finance Officers, administrators, and Auditors can inspect these records.
    match /invoices/{invoiceId} {
      allow read: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer() || isAuditor();
      allow create, update: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer() || isAuditor();
      allow create, update: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    match /refunds/{refundId} {
      allow read: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer() || isAuditor();
      allow create, update: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

    match /commissions/{commissionId} {
      allow read: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer() || isAuditor();
      allow create, update: if isSuperAdmin() || isOrgAdmin() || isFinanceOfficer();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

  }
}
