rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }

    match /students/{studentId} {
      allow read, write: if true;
    }

    match /applications/{applicationId} {
      allow read, write: if true;
    }

    match /student_documents/{documentId} {
      allow read, write: if true;
    }

    match /support_requests/{requestId} {
      allow read, write: if true;
    }

    match /tasks/{taskId} {
      allow read, write: if true;
    }
    match /visa_cases/{caseId} { allow read, write: if true; }
    match /universities/{universityId} { allow read, write: if true; }
    match /country_requirements/{countryId} { allow read, write: if true; }

    match /consent_records/{consentId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /conversations/{conversationId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /audit_logs/{logId} { allow read, write: if true; }
    match /{document=**} { allow read, write: if true; }
  }
}
