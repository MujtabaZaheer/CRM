rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for auth & role verification
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'platform_super_admin';
    }
    
    function isOrgAdmin() {
      return isSignedIn() && getUserData().role == 'org_admin';
    }
    
    function isCounsellor() {
      return isSignedIn() && getUserData().role == 'counsellor';
    }

    // ----------------------------------------------------
    // USERS COLLECTION
    // ----------------------------------------------------
    match /users/{userId} {
      // Anyone signed in can read user profiles (needed for directory & auth context)
      allow read: if isSignedIn();
      
      // Self-registration: User can create their initial profile document
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // Role & profile updates: Super Admin or Org Admin can update any profile. Users can update non-role fields of their own document.
      allow update: if isSuperAdmin() || isOrgAdmin() || 
        (isSignedIn() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
        
      allow delete: if isSuperAdmin();
    }

    // ----------------------------------------------------
    // LEADS COLLECTION
    // ----------------------------------------------------
    match /leads/{leadId} {
      // Super Admin, Org Admin, and Counsellors can read and create leads
      allow read: if isSuperAdmin() || isOrgAdmin() || isCounsellor();
      allow create: if isSuperAdmin() || isOrgAdmin() || isCounsellor();
      
      // Updates and deletions
      allow update: if isSuperAdmin() || isOrgAdmin() || isCounsellor();
      allow delete: if isSuperAdmin() || isOrgAdmin();
    }

  }
}
